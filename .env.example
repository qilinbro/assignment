# ============================================
# Assignment Submission System - Environment Variables
# ============================================

# --------------------------------------------
# Application Configuration
# --------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.com

# --------------------------------------------
# Database Configuration (when ready to integrate)
# --------------------------------------------
#DATABASE_URL=postgresql://user:password@localhost:5432/assignment_db
#DATABASE_POOL_SIZE=10

# --------------------------------------------
# Authentication (when ready to integrate)
# --------------------------------------------
#NEXTAUTH_URL=https://your-domain.com
#NEXTAUTH_SECRET=your-secret-key-here
#GITHUB_CLIENT_ID=your-github-client-id
#GITHUB_CLIENT_SECRET=your-github-client-secret

# --------------------------------------------
# AI Service Configuration (Claude API for AI Grading Assistant)
# --------------------------------------------
#ANTHROPIC_API_KEY=your-anthropic-api-key-here
#AI_MODEL=claude-3-5-sonnet-20241022
#AI_MAX_TOKENS=4096

# --------------------------------------------
# File Storage Configuration
# --------------------------------------------
# AWS S3 Configuration
#AWS_ACCESS_KEY_ID=your-aws-access-key
#AWS_SECRET_ACCESS_KEY=your-aws-secret-key
#AWS_REGION=us-east-1
#AWS_S3_BUCKET=assignment-submissions

# Cloudflare R2 Configuration (alternative)
#R2_ACCESS_KEY_ID=your-r2-access-key
#R2_SECRET_ACCESS_KEY=your-r2-secret-key
#R2_BUCKET_NAME=assignment-submissions
#R2_ACCOUNT_ID=your-r2-account-id

# --------------------------------------------
# Email Configuration (for notifications)
# --------------------------------------------
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=your-email@gmail.com
#SMTP_PASS=your-app-password
#EMAIL_FROM=noreply@your-domain.com

# --------------------------------------------
# Rate Limiting & Security
# --------------------------------------------
#RATE_LIMIT_MAX_REQUESTS=100
#RATE_LIMIT_WINDOW_MS=60000
#CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# --------------------------------------------
# Feature Flags
# --------------------------------------------
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
# 默认隐藏评分页中的 AI 辅助 UI；设为 true 后以页内折叠卡形式启用
NEXT_PUBLIC_ENABLE_AI_UI=false
NEXT_PUBLIC_ENABLE_REVIEW=false
NEXT_PUBLIC_MAX_FILE_SIZE_MB=10
NEXT_PUBLIC_MAX_FILES_PER_SUBMISSION=10

# --------------------------------------------
# Logging & Monitoring
# --------------------------------------------
#LOG_LEVEL=info
#SENTRY_DSN=your-sentry-dsn-here
#ANALYTICS_ID=your-analytics-id
